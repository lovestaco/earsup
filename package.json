{
  "name": "earsup",
  "private": true,
  "version": "1.0.7",
  "description": "Chrome extension: press play on any heading and hear that section read aloud.",
  "license": "MIT",
  "author": "Maneshwar",
  "homepage": "https://lovestaco.github.io/earsup/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovestaco/earsup.git"
  },
  "bugs": {
    "url": "https://github.com/lovestaco/earsup/issues"
  },
  "keywords": [
    "chrome-extension",
    "text-to-speech",
    "read-aloud",
    "tts",
    "gemini",
    "accessibility"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.scripts.config.ts --mode content && vite build --config vite.scripts.config.ts --mode background",
    "dev": "vite build --watch",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
